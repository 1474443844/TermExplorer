<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fm_drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ========== 主体内容区域 ========== -->
    <!-- 紧凑型双面板容器 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/fm_bg"
        android:orientation="vertical">

        <!-- 扁平化原生标题栏 -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/fm_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/fm_surface"
            android:elevation="1dp"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
            app:contentInsetStartWithNavigation="0dp"
            app:navigationContentDescription="@string/sidebar_open"
            app:popupTheme="@style/ThemeOverlay.AppCompat.Dark">

            <!-- 自定义标题与副标题布局 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <!-- 路径标题：强制单行，开头省略 -->
                <TextView
                    android:id="@+id/tv_toolbar_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="start"
                    android:singleLine="true"
                    android:textColor="@color/fm_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <!-- 容量副标题：强制单行，末尾省略 -->
                <TextView
                    android:id="@+id/tv_toolbar_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textColor="@color/fm_accent"
                    android:textSize="11sp" />
            </LinearLayout>

        </androidx.appcompat.widget.Toolbar>

        <!-- 紧凑型双面板容器 -->
        <!-- 紧凑型双面板容器 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:padding="6dp">

            <!-- 左面板 -->
            <include
                android:id="@+id/layout_panel_left"
                layout="@layout/include_file_panel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />

            <!-- 中间分割缝隙 -->
            <View
                android:layout_width="6dp"
                android:layout_height="match_parent" />

            <!-- 右面板 -->
            <include
                android:id="@+id/layout_panel_right"
                layout="@layout/include_file_panel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- MT风格 底部紧凑动作栏 (使用原生无边框按钮样式) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/fm_surface"
            android:elevation="4dp"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp">

            <ImageButton
                android:id="@+id/btn_action_undo"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:src="@drawable/baseline_keyboard_arrow_left_24"
                android:tint="@color/fm_text_primary" />

            <ImageButton
                android:id="@+id/btn_action_redo"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:src="@drawable/baseline_keyboard_arrow_right_24"
                android:tint="@color/fm_text_primary" />

            <ImageButton
                android:id="@+id/btn_action_create"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:contentDescription="Create File/Folder"
                android:src="@drawable/baseline_add_24"
                android:tint="@color/fm_text_primary" />

            <ImageButton
                android:id="@+id/btn_action_sync"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:src="@drawable/baseline_arrow_team_24_left"
                android:tint="@color/fm_text_primary" />

            <ImageButton
                android:id="@+id/btn_action_goback"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:src="@drawable/baseline_arrow_upward_24"
                android:tint="@color/fm_text_primary" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========== 侧边栏抽屉 (原生 LinearLayout 结构) ========== -->
    <LinearLayout
        android:id="@+id/fm_sidebar"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/fm_surface"
        android:clickable="true"
        android:elevation="8dp"
        android:focusable="true"
        android:orientation="vertical">

        <!-- 侧栏头部 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/sidebar_title"
                android:textColor="@color/fm_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_sidebar_refresh"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:background="@drawable/bg_fm_chip"
                android:minWidth="0dp"
                android:paddingHorizontal="12dp"
                android:stateListAnimator="@null"
                android:text="@string/sidebar_refresh"
                android:textColor="@color/fm_text_primary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/fm_stroke" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="6dp"
            android:text="@string/sidebar_places"
            android:textColor="@color/fm_text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 侧栏书签列表 -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_sidebar_places"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingHorizontal="12dp"
            android:paddingBottom="8dp"
            android:scrollbars="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/fm_stroke" />

        <!-- 侧栏尾部按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <Button
                android:id="@+id/btn_sidebar_swap_panels"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_fm_chip"
                android:stateListAnimator="@null"
                android:text="@string/sidebar_swap_panels"
                android:textColor="@color/fm_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_sidebar_same_both"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_fm_chip"
                android:stateListAnimator="@null"
                android:text="@string/sidebar_same_both"
                android:textColor="@color/fm_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/sidebar_help"
                android:textColor="@color/fm_text_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>