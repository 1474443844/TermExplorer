<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_file_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="4dp"
    android:paddingVertical="4dp">

    <ImageView
        android:id="@+id/iv_item_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:gravity="center"
        app:tint="@color/fm_text_primary"
        android:background="@drawable/bg_fm_item_icon"
        android:padding="4dp"
        android:src="@drawable/baseline_folder_24" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_item_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:text="filename.txt"
            android:textColor="@color/fm_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_item_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="12 KB • 07-16 12:00 • [rw-]"
            android:textColor="@color/fm_text_muted"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
